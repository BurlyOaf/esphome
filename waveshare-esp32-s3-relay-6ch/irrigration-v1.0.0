uart:
  tx_pin: GPIO17
  rx_pin: GPIO18
  baud_rate: 115200

# buzzer
output:
  - platform: ledc
    pin: GPIO21
    id: buzzer


rtttl:
  output: buzzer
  id: rtttl_buzzer
  gain: 30%
#  - rtttl.play:
#    rtttl: !lambda "return song_str;"

#LED Arduino Framework
#light:
#  - platform: neopixelbus
#    type: RGB
#    variant: 800KBPS
#    pin: GPIO38
#    num_leds: 1
#    name: "RGB LED"
#    id: rgb_led

#LED esp-idf Framework
light:
  - platform: esp32_rmt_led_strip
    id: rgb_led
    name: "RGB LED"
    pin: GPIO38
    num_leds: 1
    rmt_channel: 0
    rgb_order: RGB
    chipset: ws2812

button:
  - platform: restart
    name: "Restart"
    id: restart_button
    entity_category: config

  - platform: factory_reset
    name: "Factory Reset"
    id: reset
    entity_category: config

  - platform: safe_mode
    name: "Safe Mode"
    internal: false
    entity_category: config

sensor:
  - platform: wifi_signal
    name: "WiFi Signal"
    id: wifi_signal_db
    update_interval: 60s
    entity_category: diagnostic
  - platform: uptime
    type: seconds
    name: Uptime Sensor
    update_interval: 60s

  # Reports the WiFi signal strength in %
  - platform: copy
    source_id: wifi_signal_db
    name: "WiFi Strength"
    filters:
      - lambda: return min(max(2 * (x + 100.0), 0.0), 100.0);
    unit_of_measurement: "%"
    entity_category: diagnostic

# Add template sensors for each zone to track remaining time
#sensor:
  # Zone 1 - Front Yard (1)
  - platform: template
    name: "Zone 1 Remaining Time"
    unit_of_measurement: "minutes"
    state_class: measurement
    accuracy_decimals: 0
    lambda: |-
      if (id(relay6).state) {
        unsigned long elapsed_time = millis() / 1000;  // Time since ESP started (in seconds)
        unsigned long total_time = 25 * 60;  // 25 minutes in seconds
        unsigned long remaining_time = total_time - (elapsed_time % total_time);
        return remaining_time / 60.0;  // Convert to minutes
      }
      return 0.0;

  # Zone 2 - Front Garden (2)
  - platform: template
    name: "Zone 2 Remaining Time"
    unit_of_measurement: "minutes"
    state_class: measurement
    accuracy_decimals: 0
    lambda: |-
      if (id(relay5).state) {
        unsigned long elapsed_time = millis() / 1000;
        unsigned long total_time = 25 * 60;  // 25 minutes
        unsigned long remaining_time = total_time - (elapsed_time % total_time);
        return remaining_time / 60.0;
      }
      return 0.0;

  # Zone 3 - Side Yard (3)
  - platform: template
    name: "Zone 3 Remaining Time"
    unit_of_measurement: "minutes"
    state_class: measurement
    accuracy_decimals: 0
    lambda: |-
      if (id(relay4).state) {
        unsigned long elapsed_time = millis() / 1000;
        unsigned long total_time = 25 * 60;  // 25 minutes
        unsigned long remaining_time = total_time - (elapsed_time % total_time);
        return remaining_time / 60.0;
      }
      return 0.0;

  # Zone 4 - Back Yard Close (4)
  - platform: template
    name: "Zone 4 Remaining Time"
    unit_of_measurement: "minutes"
    state_class: measurement
    accuracy_decimals: 0
    lambda: |-
      if (id(relay3).state) {
        unsigned long elapsed_time = millis() / 1000;
        unsigned long total_time = 25 * 60;  // 25 minutes
        unsigned long remaining_time = total_time - (elapsed_time % total_time);
        return remaining_time / 60.0;
      }
      return 0.0;

  # Zone 5 - Back Yard Far (5)
  - platform: template
    name: "Zone 5 Remaining Time"
    unit_of_measurement: "minutes"
    state_class: measurement
    accuracy_decimals: 0
    lambda: |-
      if (id(relay2).state) {
        unsigned long elapsed_time = millis() / 1000;
        unsigned long total_time = 25 * 60;  // 25 minutes
        unsigned long remaining_time = total_time - (elapsed_time % total_time);
        return remaining_time / 60.0;
      }
      return 0.0;

  #Sprinkler component time remaining test    
  - platform: template
    name: "Front Yard Remaining Time"
    id: front_yard_remaining_time
    unit_of_measurement: "seconds"
    accuracy_decimals: 0
    lambda: |-
      float remaining_time = id(front_yard_sprinkler_duration).state - (millis() - id(sprinkler_ctrlr).state) / 1000.0;
      if (remaining_time < 0) {
        remaining_time = 0;  // Prevent negative time
      }
      return remaining_time;
