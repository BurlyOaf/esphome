sprinkler:
  - id: sprinkler_ctrlr
    main_switch: Sprinklers
    auto_advance_switch: Sprinklers Auto Advance
    valve_overlap: 5s
    valves:
      - valve_switch: ${valve_zone_1}
        enable_switch: Enable ${valve_zone_1}
        pump_switch_id: relay1
        valve_switch_id: relay6
        run_duration: 900s  # Default duration in seconds
      - valve_switch: ${valve_zone_2}
        enable_switch: Enable ${valve_zone_2}
        pump_switch_id: relay1
        valve_switch_id: relay5
        run_duration: 900s  # Default duration in seconds
      - valve_switch: ${valve_zone_3}
        enable_switch: Enable ${valve_zone_3}
        pump_switch_id: relay1
        valve_switch_id: relay4
        run_duration: 900s  # Default duration in seconds
      - valve_switch: ${valve_zone_4}
        enable_switch: Enable ${valve_zone_4}
        pump_switch_id: relay1
        valve_switch_id: relay3
        run_duration: 900s  # Default duration in seconds
      - valve_switch: ${valve_zone_5}
        enable_switch: Enable ${valve_zone_5}
        pump_switch_id: relay1
        valve_switch_id: relay2
        run_duration: 900s  # Default duration in seconds
number:
  - platform: template
    name: "${valve_zone_1} Duration"
    id: zone_1_sprinkler_duration
    #initial_value: 900
    min_value: 1
    max_value: 3600
    step: 1
    set_action:
      - lambda: |-
          id(sprinkler_ctrlr).valve_run_duration(id(zone_1_sprinkler_duration).state);

  - platform: template
    name: "${valve_zone_2} Duration"
