substitutions:
  name: waveshare-esp32s3-6ch-ec6740
  friendly_name: Waveshare ESP32-S3-Relay-6CH
packages:
  esphome.bluetooth-proxy: github://esphome/bluetooth-proxies/esp32-generic/esp32-generic.yaml@main
esphome:
  name: ${name}
  name_add_mac_suffix: false
  friendly_name: ${friendly_name}
  platformio_options:
    board_build.flash_mode: dio


esp32:
  board: esp32-s3-devkitc-1
  framework:
#    type: arduino
    type: esp-idf
    
# Enable logging
logger:

# Enable Home Assistant API #   key: "TZO7R7dmJimrCH1WhgsvHnby52wmo2H6g4Sb3YFLeag="
api:
  encryption:
    key: 7v/vqO+vivn3xjlzBczvE74rgXMBDhIi4wYDOqlf38o=
  services:
    - service: play_rtttl
      variables:
        song_str: string
      then:
        - rtttl.play:
            rtttl: !lambda "return song_str;"
    - service: set_multiplier
      variables:
        multiplier: float
      then:
        - sprinkler.set_multiplier:
            id: sprinkler_ctrlr
            multiplier: !lambda 'return multiplier;'
    - service: start_full_cycle
      then:
        - sprinkler.start_full_cycle: sprinkler_ctrlr
    - service: start_single_valve
      variables:
        valve: int
      then:
        - sprinkler.start_single_valve:
            id: sprinkler_ctrlr
            valve_number: !lambda 'return valve;'
    - service: next_valve
      then:
        - sprinkler.next_valve: sprinkler_ctrlr
    - service: previous_valve
      then:
        - sprinkler.previous_valve: sprinkler_ctrlr
    - service: shutdown
      then:
        - sprinkler.shutdown: sprinkler_ctrlr

ota:
  - platform: esphome
    password: "8be8e6ede05aa3f2fc99370b10e42ab7"

esp32_ble_tracker:
  scan_parameters:
    interval: 1100ms
    window: 1100ms
    active: true

bluetooth_proxy:
  active: true

#ota:
#  - platform: esphome
#    password: "0c6f6cf00ed0c4985422b0db531a94af"

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  # Enable fallback hotspot (captive portal) in case wifi connection fails
  ap:
    ssid: "Waveshare Fallback Hotspot"
    password: "0421875831"

captive_portal:

#packages:
#  esphome.bluetooth-proxy: github://esphome/bluetooth-proxies/esp32-generic.yaml@main

web_server:
  port: 80

time:
  - platform: homeassistant
    id: homeassistant_time
  - platform: sntp


binary_sensor:
  - platform: status
    name: "Status"

  - platform: gpio
    name: "Boot Button"
    pin:
      number: 0
      inverted: true
      ignore_strapping_warning: true
      mode:
        input: true
    disabled_by_default: true
    on_press:
      then:
        - button.press: restart_button
  - platform: gpio
    name: "Green"
    id: button_Green # ADD A STOP ALL DOUBLE CLICK FUNCTION
    pin:
      number: 12
      inverted: true
      mode:
        input: true
        pullup: true
  - platform: gpio
    name: "Zone 1"
    id: button_white1
    pin:
      number: 11
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on : relay6
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay6
  - platform: gpio
    name: "Zone 2"
    id: button_white2
    pin:
      number: 35
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay5
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay4
  - platform: gpio
    name: "Zone 3"
    id: button_white3
    pin:
      number: 37
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay4
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay4
  - platform: gpio
    name: "Zone 4"
    id: button_white4
    pin:
      number: 36
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay3
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay3

    
    

text_sensor:
  - platform: version
    name: "Firmware Version"
  - platform: wifi_info
    ip_address:
      name: "IP Address"
      entity_category: diagnostic
    ssid:
      name: "Connected SSID"
      entity_category: diagnostic
    mac_address:
      name: "Mac Address"
      entity_category: diagnostic

switch:
  - platform: gpio
    pin: GPIO46
    id: relay6
    name: Zone 1 Front Lawn
    restore_mode: ALWAYS_OFF
    on_turn_on:
#      - switch.turn_on: relay1  
      - delay: 25minutes
#      - switch.turn_off: relay1  # Turn off Master solenoid first to drop pressure
#      - delay: 2s
      - switch.turn_off: relay6
#    on_turn_off: 
#      - delay: 1s # Delay then turn Zone off
#      - switch.turn_off: relay1
  - platform: gpio
    pin: GPIO45
    id: relay5
    name: Zone 2 Side Lawn
    restore_mode: ALWAYS_OFF
    on_turn_on:
#      - switch.turn_on: relay1
      - delay: 25minutes
#      - switch.turn_off: relay1  # Turn off Master solenoid first to drop pressure
#      - delay: 2s
      - switch.turn_off: relay5
#    on_turn_off: 
#      - delay: 1s # Delay then turn Master off
#      - switch.turn_off: relay1
  - platform: gpio
    pin: GPIO42
    id: relay4
    name: Zone 3 Back Lawn
    restore_mode: ALWAYS_OFF
    on_turn_on:
#      - switch.turn_on: relay1
      - delay: 25minutes
#      - switch.turn_off: relay1  # Turn off Master solenoid first to drop pressure
#      - delay: 2s
      - switch.turn_off: relay4
#    on_turn_off: 
#      - delay: 1s # Delay then turn Master off
#      - switch.turn_off: relay1
  - platform: gpio
    pin: GPIO41
    id: relay3
    name: Zone 4 Hedge
    restore_mode: ALWAYS_OFF
    on_turn_on:
#      - switch.turn_on: relay1
      - delay: 25minutes
#      - switch.turn_off: relay1  # Turn off Master solenoid first to drop pressure
#      - delay: 2s
      - switch.turn_off: relay3
#    on_turn_off: 
#      - delay: 1s # Delay then turn Master off
#      - switch.turn_off: relay1
  - platform: gpio
    pin:
      number: GPIO2
#      ignore_strapping_warning: true
    id: relay2
    name: Zone 5 Veggies
    restore_mode: ALWAYS_OFF
    on_turn_on:
#      - switch.turn_on: relay1
      - delay: 25minutes
#      - switch.turn_off: relay1  # Turn off Master solenoid first to drop pressure
#      - delay: 2s
      - switch.turn_off: relay2
#    on_turn_off: 
#      - delay: 1s # Delay then turn Master off
#      - switch.turn_off: relay1
  - platform: gpio
    pin:
      number: GPIO1
#      ignore_strapping_warning: true
    id: relay1
    name: Master Solenoid
    restore_mode: ALWAYS_OFF

