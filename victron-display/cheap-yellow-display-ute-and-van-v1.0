substitutions:
  smart_shunt_1_mac_address: fc78d9a837ce
  smart_shunt_1_encryption_key: 74f2facd85124d32458e2cb3a50d4939
  smart_solar_1_mac_address: c4d3a6ad675b
  smart_solar_1_encryption_key: 0e9fa0a28447d098d7874eb66943736a
  smart_shunt_2_mac_address: f642d3f8d807
  smart_shunt_2_encryption_key: 4f8ac5d85932ec74c3bf2b0e66f3547f
  smart_solar_2_mac_address: d423f3b1a50f
  smart_solar_2_encryption_key: 5bb8e06dc867fb809301ec2ba0830ffc
  smart_ac_charger_2_mac: f7f84603a571
  smart_ac_charger_2_encryption_key: 1ca25b986910ab65e3683e45eb8edeeb

esphome:
  name: victron-cyd
  friendly_name: Victron CYD

esp32:
  board: esp32dev
  framework:
    type: arduino

logger:
api:
ota:

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

# ========= SPI for Display + Touch =========
spi:
  clk_pin: GPIO14
  mosi_pin: GPIO13
  miso_pin: GPIO12

# ========= Display =========
display:
  - platform: ili9341
    model: TFT 2.4
    cs_pin: GPIO15
    dc_pin: GPIO2
    led_pin: GPIO21
    reset_pin: GPIO4
    rotation: 0
    update_interval: 2s
    lambda: |-
      it.fill(Color::BLACK);

      if (id(page_index) == 0) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "System Overview");

        // Shunt 1 summary
        it.printf(10, 50, id(font_small), TextAlign::TOP_LEFT, "Bat: %.1fV %.1fA", id(shunt1_voltage).state, id(shunt1_current).state);
        it.printf(10, 80, id(font_small), TextAlign::TOP_LEFT, "SOC: %.0f%%  TtG: %.1f h", id(shunt1_soc).state, id(shunt1_ttg).state / 60.0);
        it.printf(10, 110, id(font_small), TextAlign::TOP_LEFT, "Used: %.0fAh", id(shunt1_consumed_ah).state);

        // Solar 1 summary
        it.printf(10, 150, id(font_small), TextAlign::TOP_LEFT, "Solar: %.1fA %.0fW", id(solar1_current).state, id(solar1_power).state);
      }
      else if (id(page_index) == 1) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "Shunt 1");
        it.printf(160, 60, id(font_medium), TextAlign::TOP_CENTER, "%.1f V", id(shunt1_voltage).state);
        it.printf(160, 120, id(font_medium), TextAlign::TOP_CENTER, "%.1f A", id(shunt1_current).state);
        it.printf(160, 180, id(font_medium), TextAlign::TOP_CENTER, "%.0f W", id(shunt1_power).state);
      }
      else if (id(page_index) == 2) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "Shunt 2");
        it.printf(160, 60, id(font_medium), TextAlign::TOP_CENTER, "%.1f V", id(shunt2_voltage).state);
        it.printf(160, 120, id(font_medium), TextAlign::TOP_CENTER, "%.1f A", id(shunt2_current).state);
        it.printf(160, 180, id(font_medium), TextAlign::TOP_CENTER, "%.0f W", id(shunt2_power).state);
      }
      else if (id(page_index) == 3) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "Solar 1");
        it.printf(160, 60, id(font_medium), TextAlign::TOP_CENTER, "%.1f V", id(solar1_voltage).state);
        it.printf(160, 120, id(font_medium), TextAlign::TOP_CENTER, "%.1f A", id(solar1_current).state);
        it.printf(160, 180, id(font_medium), TextAlign::TOP_CENTER, "%.0f W", id(solar1_power).state);
      }
      else if (id(page_index) == 4) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "Solar 2");
        it.printf(160, 60, id(font_medium), TextAlign::TOP_CENTER, "%.1f V", id(solar2_voltage).state);
        it.printf(160, 120, id(font_medium), TextAlign::TOP_CENTER, "%.1f A", id(solar2_current).state);
        it.printf(160, 180, id(font_medium), TextAlign::TOP_CENTER, "%.0f W", id(solar2_power).state);
      }
      else if (id(page_index) == 5) {
        it.printf(160, 10, id(font_large), TextAlign::TOP_CENTER, "AC Charger");
        it.printf(160, 80, id(font_medium), TextAlign::TOP_CENTER, "SOC: %.0f %%", id(shunt1_soc).state);
        it.printf(160, 160, id(font_medium), TextAlign::TOP_CENTER, "Used: %.0f Ah", id(shunt1_consumed_ah).state);
      }

# ========= Touchscreen =========
touchscreen:
  - platform: xpt2046
    cs_pin: GPIO33
    interrupt_pin: GPIO36
    update_interval: 50ms
    report_interval: 500ms
    on_touch:
      then:
        - lambda: |-
            id(page_index) += 1;
            if (id(page_index) > 5) {   // wrap around at 6 pages
              id(page_index) = 0;
            }

# ========= Global Page Index =========
globals:
  - id: page_index
    type: int
    restore_value: no
    initial_value: '0'   # start at Overview page on boot

# ========= BLE =========
esp32_ble_tracker:

victron_ble:
  - id: shunt1
    mac_address: ${smart_shunt_1_mac_address}
    encryption_key: ${smart_shunt_1_encryption_key}

  - id: shunt2
    mac_address: ${smart_shunt_2_mac_address}
    encryption_key: ${smart_shunt_2_encryption_key}

  - id: solar1
    mac_address: ${smart_solar_1_mac_address}
    encryption_key: ${smart_solar_1_encryption_key}

  - id: solar2
    mac_address: ${smart_solar_2_mac_address}
    encryption_key: ${smart_solar_2_encryption_key}

  - id: ac_charger
    mac_address: ${smart_ac_charger_2_mac}
    encryption_key: ${smart_ac_charger_2_encryption_key}

# ========= Sensors =========
sensor:
  # Shunt 1
  - platform: victron_ble
    victron_ble_id: shunt1
    type: battery_voltage
    id: shunt1_voltage
  - platform: victron_ble
    victron_ble_id: shunt1
    type: battery_current
    id: shunt1_current
  - platform: victron_ble
    victron_ble_id: shunt1
    type: battery_power
    id: shunt1_power
  - platform: victron_ble
    victron_ble_id: shunt1
    type: soc
    id: shunt1_soc
  - platform: victron_ble
    victron_ble_id: shunt1
    type: consumed_ah
    id: shunt1_consumed_ah
  - platform: victron_ble
    victron_ble_id: shunt1
    type: time_to_go
    id: shunt1_ttg

  # Shunt 2
  - platform: victron_ble
    victron_ble_id: shunt2
    type: battery_voltage
    id: shunt2_voltage
  - platform: victron_ble
    victron_ble_id: shunt2
    type: battery_current
    id: shunt2_current
  - platform: victron_ble
    victron_ble_id: shunt2
    type: battery_power
    id: shunt2_power

  # Solar 1
  - platform: victron_ble
    victron_ble_id: solar1
    type: panel_voltage
    id: solar1_voltage
  - platform: victron_ble
    victron_ble_id: solar1
    type: panel_current
    id: solar1_current
  - platform: victron_ble
    victron_ble_id: solar1
    type: panel_power
    id: solar1_power

  # Solar 2
  - platform: victron_ble
    victron_ble_id: solar2
    type: panel_voltage
    id: solar2_voltage
  - platform: victron_ble
    victron_ble_id: solar2
    type: panel_current
    id: solar2_current
  - platform: victron_ble
    victron_ble_id: solar2
    type: panel_power
    id: solar2_power

# ========= Fonts =========
font:
  - file: "gfonts://Roboto"
    id: font_small
    size: 20
  - file: "gfonts://Roboto"
    id: font_medium
    size: 28
  - file: "gfonts://Roboto"
    id: font_large
    size: 36
