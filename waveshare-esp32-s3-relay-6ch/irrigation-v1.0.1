binary_sensor:
  - platform: status
    name: "Status"

  - platform: gpio
    name: "Boot Button"
    pin:
      number: 0
      inverted: true
      ignore_strapping_warning: true
      mode:
        input: true
    disabled_by_default: true
    on_press:
      then:
        - button.press: restart_button
  - platform: gpio
    name: "Green"
    id: button_Green # ADD A STOP ALL DOUBLE CLICK FUNCTION
    pin:
      number: 12
      inverted: true
      mode:
        input: true
        pullup: true
  - platform: gpio
    name: "Button 1"
    id: button_white1
    pin:
      number: 11
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on : relay6
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay6
  - platform: gpio
    name: "Button 2"
    id: button_white2
    pin:
      number: 35
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay5
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay4
  - platform: gpio
    name: "Button 3"
    id: button_white3
    pin:
      number: 37
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay4
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay4
  - platform: gpio
    name: "Button 4"
    id: button_white4
    pin:
      number: 36
      inverted: true
      mode:
        input: true
        pullup: true
    on_press:
      - switch.turn_on: relay3
    on_double_click:
      min_length: 50ms
      max_length: 350ms
      then:
        - switch.turn_off: relay3

    
    

