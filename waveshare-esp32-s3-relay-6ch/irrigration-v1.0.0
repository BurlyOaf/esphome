sprinkler:
  - id: sprinkler_ctrlr
    main_switch: "Sprinklers"
    auto_advance_switch: "Sprinklers Auto Advance"
    valve_overlap: 5s
    valves:
      - valve_switch: "Front Yard (1)"
        enable_switch: "Enable Front Yard (1)"
        pump_switch_id: relay1
        run_duration_number: "Front Yard Sprinkler Duration"
        valve_switch_id: relay6

      - valve_switch: "Front Garden (2)"
        enable_switch: "Enable Front Garden (2)"
        pump_switch_id: relay1
        run_duration_number: "Front Garden Sprinkler Duration"
        valve_switch_id: relay5
 
      - valve_switch: "Side Yard (3)"
        enable_switch: "Enable Side Yard (3)"
        pump_switch_id: relay1
        run_duration_number: "Side Yard Sprinkler Duration"
        valve_switch_id: relay4
 
      - valve_switch: "Back Yard Close (4)"
        enable_switch: "Enable Back Yard Close (4)"
        pump_switch_id: relay1
        run_duration_number: "Back Yard Close Sprinkler Duration"
        valve_switch_id: relay3


      - valve_switch: "Back Yard Far (5)"
        enable_switch: "Enable Back Yard Far (5)"
        pump_switch_id: relay1
        run_duration_number: "Back Yard Far Sprinkler Duration"
        valve_switch_id: relay2

number:
  - platform: template
    name: "Front Yard Sprinkler Duration"
    id: front_yard_sprinkler_duration
    initial_value: 900
    min_value: 1
    max_value: 3600
    step: 1
    set_action:
      - lambda: |-
          id(sprinkler_ctrlr).set_run_duration_number(id(front_yard_sprinkler_duration).state);
